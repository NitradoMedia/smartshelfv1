# Demo clips without camera (true) / live Reolink (false)
DEMO_MODE=true
# AI: yolo | openai | mock
AI_BACKEND=yolo
YOLO_MODEL=yolov8n.pt

# Matching window: seconds before receipt timestamp
LOOKBACK_SECONDS=5
CLIP_DURATION_SECONDS=12
MISMATCH_TOLERANCE=0
SCAN_INTERVAL_SECONDS=30
POS_TIMEZONE=Europe/Berlin

# Reolink (set DEMO_MODE=false when ready)
REOLINK_HOST=
REOLINK_USER=admin
REOLINK_PASSWORD=
REOLINK_CHANNEL=0
REOLINK_RTSP_URL=
REOLINK_HTTPS=false

# FTP video source (optional; can also be set in Dashboard)
FTP_ENABLED=false
FTP_HOST=
FTP_PORT=21
FTP_USER=
FTP_PASSWORD=
FTP_REMOTE_DIR=/
FTP_PASSIVE=true

# Optional Vision LLM
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
