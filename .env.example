# Demo / first start
DEMO_MODE=true
AI_BACKEND=mock

# Matching window: seconds before receipt timestamp
LOOKBACK_SECONDS=5
CLIP_DURATION_SECONDS=12
MISMATCH_TOLERANCE=0
SCAN_INTERVAL_SECONDS=30
POS_TIMEZONE=Europe/Berlin

# Reolink (set DEMO_MODE=false when ready)
REOLINK_HOST=
REOLINK_USER=admin
REOLINK_PASSWORD=
REOLINK_CHANNEL=0
REOLINK_RTSP_URL=
REOLINK_HTTPS=false

