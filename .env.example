# Lokaler Betrieb (Docker auf dem PC im gleichen LAN wie die Kamera)
DEMO_MODE=false
AI_BACKEND=yolo
YOLO_MODEL=/data/models/yolov8n.pt

LOOKBACK_SECONDS=5
CLIP_DURATION_SECONDS=12
MISMATCH_TOLERANCE=0
SCAN_INTERVAL_SECONDS=30
POS_TIMEZONE=Europe/Berlin

# Optional: Reolink-API (zusätzlich zur RTSP-URL im Dashboard)
REOLINK_HOST=192.168.1.32
REOLINK_USER=admin
REOLINK_PASSWORD=admin
REOLINK_CHANNEL=0
REOLINK_RTSP_URL=rtsp://admin:admin@192.168.1.32:554/11

FTP_ENABLED=false
HOST_PORT=8090
